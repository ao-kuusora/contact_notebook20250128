# このファイルをコピーして .env と .env.local を作成してください
#   cp .env.example .env
#   cp .env.example .env.local
# (.env は Prisma CLI 用、.env.local は Next.js 用)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contact_notebook"
JWT_SECRET="change-me-to-a-long-random-string"

# Web Push 通知用。VAPIDキーを生成して同じ値を .env と Vercel の環境変数に設定
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
