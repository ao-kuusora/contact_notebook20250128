# このファイルをコピーして .env と .env.local を作成してください
#   cp .env.example .env
#   cp .env.example .env.local
# (.env は Prisma CLI 用、.env.local は Next.js 用)

# アプリ用接続文字列（Supabase Transaction pooler など）
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"

# Prisma migrate deploy 用接続文字列（Supabase Session pooler のポート5432など）
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-string"

# Web Push 通知用。VAPIDキーを生成して同じ値を .env と Vercel の環境変数に設定
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
