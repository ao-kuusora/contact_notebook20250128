# このファイルをコピーして .env と .env.local を作成してください
#   cp .env.example .env
#   cp .env.example .env.local
# (.env は Prisma CLI 用、.env.local は Next.js 用)

# ローカル: docker compose up -d で起動する PostgreSQL
# 本番: Neon / Supabase / Render などの接続文字列に置き換えてください
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contact_notebook"

# 十分に長いランダム文字列にしてください。例: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
